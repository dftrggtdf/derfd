# Schimbă linia picom cu asta (folosește placa video Intel și activează VSync):
picom --backend glx --vsync &

pcmanfm --desktop &
tint2 &
GTK_THEME=Adwaita nm-applet &
volumeicon &
dunst &
mate-power-manager &
xcape -e 'Super_L=Alt_L|F3' &
copyq &
xset r rate 200 50 &
(sleep 3 && wpctl set-volume @DEFAULT_AUDIO_SOURCE@ 1.50) &

